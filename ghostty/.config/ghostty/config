# ghostty config - Ported from wezterm/kitty configuration

# Font
font-family = "SauceCodePro Nerd Font"
font-style = "Regular"
font-style-bold = "SemiBold"
font-style-italic = "Italic"
font-style-bold-italic = "SemiBold Italic"
font-size = 14
adjust-cell-height = 30%
adjust-cell-width = -10%

# Display-specific rendering overrides (swap via `ghostty-toggle-rendering`).
# Optional — Ghostty ignores if the file doesn't exist yet.
config-file = ?rendering.conf

# Cursor
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor

# Window
window-padding-x = 20
window-padding-y = 20
window-padding-balance = true
window-decoration = true
confirm-close-surface = false

# Tabs / titlebar
macos-titlebar-style = tabs

# Shell
command = /opt/homebrew/bin/fish
shell-integration = fish

# Scrollback
scrollback-limit = 10000

# macOS
macos-option-as-alt = left

# Theme: auto-switches based on macOS appearance
theme = light:serene-meadow-day,dark:serene-meadow-night
# theme = light:schpoing-light,dark:schpoing-dark

# Keybindings

# Splits (auto-equalize after creation)
keybind = cmd+d=new_split:right
keybind = chain=equalize_splits
keybind = cmd+shift+d=new_split:down
keybind = chain=equalize_splits
keybind = cmd+w=close_surface

# Pane navigation
keybind = cmd+j=goto_split:next
keybind = cmd+k=goto_split:previous

# Pane resize (chord: cmd+shift+r then h/j/k/l)
keybind = cmd+shift+r>h=resize_split:left,10
keybind = cmd+shift+r>j=resize_split:down,10
keybind = cmd+shift+r>k=resize_split:up,10
keybind = cmd+shift+r>l=resize_split:right,10

# Equalize all splits (manual; cmd+w can't chain this because the originating surface is gone)
keybind = all:cmd+ctrl+equal=equalize_splits

# Scroll
keybind = ctrl+k=scroll_page_lines:-1
keybind = ctrl+j=scroll_page_lines:1

# Tab navigation
keybind = cmd+ctrl+h=previous_tab
keybind = cmd+ctrl+l=next_tab

# Rename tab
keybind = cmd+e=prompt_surface_title

# Font size (step by 2, applies to all surfaces)
keybind = all:cmd+plus=increase_font_size:2
keybind = all:cmd+equal=increase_font_size:2
keybind = all:cmd+minus=decrease_font_size:2
keybind = all:cmd+zero=reset_font_size
